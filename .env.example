# Copy to .env for local use. Set production values in the Render/Vercel dashboards.
# --- Backend (Render) ---
# Render injects PORT automatically; this is only the local fallback.
PORT=3000

# Exact Socket.io origins. Multiple origins are comma-separated.
# Production example: https://neon-arena.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional regex for Vercel preview deployments.
# CORS_ORIGIN_REGEX=^https://neon-arena-[a-z0-9-]+\.vercel\.app$

# Only for the local single-process preview. Leave unset on Render.
# SERVE_CLIENT=true

# --- Frontend (Vercel, build-time) ---
# Leave unset locally so the Vite proxy handles /socket.io.
# Set this on Vercel to the Render service URL, without a trailing slash.
# VITE_SERVER_URL=https://neon-arena-api.onrender.com
